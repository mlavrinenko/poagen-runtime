<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd" bootstrap="./tests/bootstrap.php" colors="true" cacheDirectory="./build/cache/phpunit">
  <testsuites>
    <testsuite name="runtime-tests">
      <directory>./tests</directory>
    </testsuite>
  </testsuites>
  <coverage/>
  <php>
    <ini name="memory_limit" value="1G"/>
  </php>
  <!--
        Deprecation tracking is scoped to this package's own code and nothing
        is ignored, mirroring `../phpunit.xml.dist`'s identical comment: this
        package has never needed an `ignoreIndirectDeprecations` suppression
        (it has no dependency shaped like the cebe/php-openapi one that
        comment explains), so there is nothing to restate beyond the fact
        that if one is ever needed here, it gets its own reason written next
        to it rather than inherited from a config this file cannot include.
    -->
  <source restrictNotices="true" restrictWarnings="true">
    <include>
      <directory suffix=".php">./src</directory>
    </include>
  </source>
</phpunit>
