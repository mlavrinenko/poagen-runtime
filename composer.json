{
    "name": "poagen/client-runtime",
    "description": "Marshalling, transport and attribute runtime for clients generated by poagen.",
    "license": "MIT",
    "type": "library",
    "keywords": [
        "openapi",
        "generator",
        "client",
        "http-client"
    ],
    "authors": [
        {
            "name": "Maxim Lavrinenko",
            "email": "maxim@lavrinenko.xyz"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "ext-json": "*",
        "php-http/discovery": "^1.20",
        "phpstan/phpdoc-parser": "^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Poagen\\Runtime\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "$schema": "https://getcomposer.org/schema.json"
}
